# Copy to .env and fill in. .env is git-ignored; never commit the key.
TENDER_API_KEY=
# Site permalink: the "nodebox" in nodebox.tenderapp.com / api.tenderapp.com/nodebox
TENDER_SITE=nodebox
# Host that serves attachment downloads (download_path is relative to it).
# TENDER_ASSET_BASE=https://nodebox.tenderapp.com
# Milliseconds between API requests.
# TENDER_DELAY_MS=400
# Only fetch comments for this many discussions (for a trial run).
# TENDER_LIMIT=20
# Also export spam and deleted discussions (list data only).
# TENDER_INCLUDE_DELETED=1
# Where the database and attachments go.
# DATA_DIR=data
# For `npm run spam` (spam filter). Not needed if you are signed in with `ant auth login`.
ANTHROPIC_API_KEY=
# SPAM_MODEL=claude-opus-5-5
# SPAM_EFFORT=low
# SPAM_CONCURRENCY=4
