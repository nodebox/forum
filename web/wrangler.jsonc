{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nodebox-forum",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "public", "binding": "ASSETS" },
  "d1_databases": [
    // Create with `wrangler d1 create nodebox-forum` and paste the id here.
    { "binding": "DB", "database_name": "nodebox-forum", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  // Cloudflare Email Sending, for sign-in links. The sending domain must be onboarded in the dashboard.
  "send_email": [{ "name": "EMAIL" }],
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "nodebox-forum" }
  ],
  "vars": {
    "SITE_NAME": "NodeBox Forum",
    // Absolute origin, used in sign-in emails and the Google redirect URI.
    "PUBLIC_URL": "http://localhost:8787",
    // Cloudflare Images: ids and variant names are global to the account, so everything is prefixed.
    "CF_IMAGES_PREFIX": "nodebox-forum-",
    "CF_IMAGES_VARIANT_POST": "nodebox-forum-post",
    "CF_IMAGES_VARIANT_THUMB": "nodebox-forum-thumb",
    // "log" prints sign-in links to the console (development); "cloudflare" sends real mail.
    "MAILER": "log",
    "MAIL_FROM": "forum@nodebox.net"
  }
  // Secrets (wrangler secret put, or .dev.vars locally):
  //   GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET
  //   CF_ACCOUNT_ID, CF_IMAGES_TOKEN, CF_IMAGES_HASH (the account hash in imagedelivery.net URLs)
}
