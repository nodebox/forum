# 1Password references for the NodeBox 4 test corpus bucket. Only references
# live here; `npm run corpus:push` resolves them with `op run`. This is the key
# that can write; CI gets a read-only one.
CORPUS_R2_ENDPOINT="op://NodeBox/NodeBox App/Test Corpus/ENDPOINT_URL"
CORPUS_R2_ACCESS_KEY_ID="op://NodeBox/NodeBox App/Test Corpus/ACCESS_KEY_ID"
CORPUS_R2_SECRET_ACCESS_KEY="op://NodeBox/NodeBox App/Test Corpus/SECRET_ACCESS_KEY"
