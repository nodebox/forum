{
  "name": "nodebox-forum",
  "version": "0.1.0",
  "private": true,
  "description": "NodeBox forum: export from Tender, and later the Cloudflare (Hono + D1 + R2) forum itself.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "env": "op inject -f -i .env.template -o .env && chmod 600 .env",
    "export": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "spam": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/spam-cli.ts"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0"
  }
}
