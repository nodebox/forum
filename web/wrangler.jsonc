{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nodebox-forum",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "public", "binding": "ASSETS" },
  // Runs on the workers.dev URL until the forum.nodebox.net custom domain is added (after the first deploy).
  "workers_dev": true,
  "observability": { "enabled": true },
  "d1_databases": [
    { "binding": "DB", "database_name": "nodebox-forum", "database_id": "c66a199f-225d-46eb-baff-0f16b4696a41", "migrations_dir": "migrations" }
  ],
  // Cloudflare Email Sending, for sign-in links. The sending domain must be onboarded in the dashboard.
  "send_email": [{ "name": "EMAIL" }],
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "nodebox-forum" }
  ],
  // Hourly: send grouped reply digests (src/notifications.ts), sweep abandoned uploads (src/files.ts)
  // and delete old refused spam (src/spamfilter.ts).
  "triggers": { "crons": ["17 * * * *"] },
  "vars": {
    "SITE_NAME": "NodeBox Forum",
    // Absolute origin, used in sign-in emails and the Google redirect URI.
    // These are the production values; `npm run dev` overrides PUBLIC_URL and MAILER.
    "PUBLIC_URL": "https://forum.nodebox.net",
    // The old Tender forum's domain. Once it is a custom domain of this Worker, every request on it
    // redirects here: old discussion URLs to their topics, the rest to the same path (web/DEPLOY.md).
    "LEGACY_HOSTS": "support.nodebox.net",
    // Cloudflare Images: image ids are global to the account, so they are prefixed. The variants are the account's shared ones.
    "CF_IMAGES_PREFIX": "nodebox-forum-",
    "CF_IMAGES_VARIANT_POST": "medium",
    "CF_IMAGES_VARIANT_THUMB": "thumb",
    // "cloudflare" sends real mail; "log" prints sign-in links to the console (development).
    "MAILER": "cloudflare",
    "MAIL_FROM": "forum@nodebox.net",
    // A banner on every page while it is set; remove it for no banner.
    "FORUM_NOTICE": "The new NodeBox forum is live! Everything from support.nodebox.net moved here: sign in with the same email to pick up your old posts. Something not working? Write to forum-support@nodebox.net."
  }
  // Secrets (wrangler secret put, or .dev.vars locally):
  //   GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET
  //   CF_ACCOUNT_ID, CF_IMAGES_TOKEN, CF_IMAGES_HASH (the account hash in imagedelivery.net URLs)
  //   ANTHROPIC_API_KEY (spam filter on new posts; without it nothing is checked)
  // Deploys run in Cloudflare Workers Builds on every push to main (web/DEPLOY.md).
}
